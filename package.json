{
  "name": "data-visualizer",
  "version": "0.4.1",
  "description": "A local desktop workspace for text and data visualization.",
  "author": "Data Visualizer",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.datavisualizer.desktop",
    "productName": "Data Visualizer",
    "directories": {
      "output": "release/0.4.1",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Data Visualizer",
      "artifactName": "Data-Visualizer-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "dv",
        "name": "Data Visualizer Document",
        "description": "Data Visualizer document",
        "role": "Editor",
        "icon": "assets/icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
